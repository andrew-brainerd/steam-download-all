{
  "name": "steam-download-all",
  "private": true,
  "scripts": {
    "build:millennium": "pnpm --filter @download-all/millennium run build",
    "dev:millennium": "pnpm --filter @download-all/millennium run dev",
    "build:decky": "pnpm --filter @download-all/decky run build",
    "deploy:deck": "pnpm --filter @download-all/decky run deploy",
    "build:standalone": "pnpm --filter @download-all/standalone run build",
    "start:standalone": "pnpm --filter @download-all/standalone run start",
    "build:installer": "pnpm --filter @download-all/installer run build",
    "dev:installer": "pnpm --filter @download-all/installer run dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "packageManager": "pnpm@11.22.0"
}
