{
  "name": "@download-all/decky",
  "version": "1.0.0",
  "private": true,
  "description": "Download All for Decky Loader: start every scheduled or paused Steam update from the Quick Access Menu.",
  "type": "module",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
