{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download All Installer",
  "version": "1.0.0",
  "identifier": "dev.brainerd.download-all-installer",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm exec tsc --noEmit && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Download All Installer",
        "width": 900,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
